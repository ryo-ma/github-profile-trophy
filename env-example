PORT=8080
# Optional: enables accessible private repository totals in the PUBLIC SVG.
# Leave both tokens blank for anonymous public-only statistics. Keep tokens out of URLs.
GITHUB_TOKEN1=
# Optional: a second personal token for the same account only.
GITHUB_TOKEN2=
GITHUB_API=https://api.github.com/graphql
# Optional: shared limits and caching across instances. Leave both blank for in-memory mode.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Opt in to requiring the shared backend; missing settings then return HTTP 503.
REQUIRE_SHARED_RATE_LIMIT=false
